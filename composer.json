{
    "name": "determly/chat-laravel",
    "description": "Persona chat for any Laravel stack. Blade, Livewire, Inertia, and Filament share one widget and one SSE dispatch endpoint.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/view": "^12.0 || ^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Determly\\Chat\\": "packages/chat/src/",
            "Determly\\Chat\\Laravel\\": "packages/chat-laravel/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Determly\\Chat\\Tests\\": "packages/chat/tests/",
            "Determly\\Chat\\Laravel\\Tests\\": "packages/chat-laravel/tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Determly\\Chat\\Laravel\\ChatServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit"
    }
}
